# Copy to .secrets/agents.env (git-ignored) and fill in. Never commit real values.
# Use free tiers only. Do not attach billing / buy credits on any of these accounts.

# Repo-scoped fine-grained GitHub token used by all agents on the VM
# (permissions on this one repo: Contents RW, Issues RW, Pull requests RW, Commit statuses RW, Metadata R)
GH_TOKEN=

# Google AI Studio keys (free tier, project WITHOUT billing). One per runtime gives attribution.
GEMINI_API_KEY_HERMES=
GEMINI_API_KEY_OPENCLAW=

# OpenRouter key (no credits purchased => only :free models, cannot be charged)
OPENROUTER_API_KEY=

# NVIDIA build.nvidia.com key (free, no card): first in every agent chain when set
NVIDIA_API_KEY=

# Optional: Ollama Cloud key, only if your account shows a free allowance and has no card
OLLAMA_API_KEY=
