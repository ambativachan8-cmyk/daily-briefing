# Copy to ~/.secrets/agents.env on the VM (run scripts/init_secrets.sh prepare first). Never commit real values.
# Use free tiers only. Do not attach billing / buy credits on any of these accounts.

# Control plane only; the agents never see it. Fine-grained, this one repo:
# Contents R, Issues RW, Pull requests RW, Commit statuses RW, Metadata R
GH_TOKEN=

# The agents' token. Fine-grained, this one repo: Contents RW, Issues RW, Pull requests RW, Metadata R.
# No Commit statuses, Administration or Workflows: agents must not be able to set the required gates.
AGENT_GH_TOKEN=

# Google AI Studio keys (free tier, project WITHOUT billing). One per runtime gives attribution.
GEMINI_API_KEY_HERMES=
GEMINI_API_KEY_OPENCLAW=

# OpenRouter key (no credits purchased => only :free models, cannot be charged)
OPENROUTER_API_KEY=

# NVIDIA build.nvidia.com key (free, no card): first in every agent chain when set
NVIDIA_API_KEY=

# Optional: Ollama Cloud key, only if your account shows a free allowance and has no card
OLLAMA_API_KEY=
